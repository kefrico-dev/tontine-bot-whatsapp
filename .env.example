# =============================================================================
# KEFRICO Tontine — exemple de configuration
# Copier ce fichier vers .env puis renseigner les valeurs.
# Ne JAMAIS commiter le fichier .env.
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- MongoDB -----------------------------------------------------------------
# Depuis l'hôte (application lancée en local, tests) :
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
#
# Depuis un conteneur Docker Compose (valeur déjà injectée par compose) :
# MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DATABASE=kefrico_tontine

# --- Meta / WhatsApp — Phase 1 -----------------------------------------------
# Optionnel en Phase 0 : aucune intégration WhatsApp n'existe encore.
# Ces variables deviendront obligatoires lorsque la Phase 1 sera implémentée.
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
